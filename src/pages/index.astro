---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro"
const projects = (await getCollection("projects")).sort(
	(a,b) => a.data.order - b.data.order,
);
---
<Base title="Home" description="Main page for website">
	<header>
		<h1>Jaden Mantie</h1>
		<div class="location">
			<p>Saskatoon, SK</p>
			<p>Open to relocate</p>
		</div>
	</header>
	<main class="grid">

		<div class="intro">
			<p>Software Developer</p>
			<p>[YOUR ONE-LINE INTRO]</p>
		</div>
		
		<div aria-hidden="true" class="orb">
			<span>JM</span>
		</div>

		<nav aria-label="Main" class="nav">
			<a class="pill" href="/#projects">Projects</a>
			<a class="pill" href="/about">About</a>
			<a class="pill" href="/Jaden-Mantie-Resume.pdf">Resume</a>
			<a class="pill" href="/#contact">Contact</a>
		</nav>

		<section id="projects" class="panel">
			<h2>Projects</h2>
			<hr>
			{projects.map((project) => (
				<a class="project-row" href={`/projects/${project.id}`}>
					<h3>{project.data.title}</h3>
					<p class="status">{project.data.status}</p>
					<ul class="stack">
						{project.data.stack.map((i) => (
							<li>{i}</li>
						))}
					</ul>
					<p class="summary">{project.data.summary}</p>
				</a>
			))}
		</section>
	</main>
	<footer>
		<div>
			<kbd>Enter</kbd>
			<span>Select</span>
		</div>
		<div>
			<kbd>Esc</kbd>
			<span>Back</span>
		</div>
	</footer>
</Base>