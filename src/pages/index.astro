---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro"
import Hub from "../components/Hub"
const projects = (await getCollection("projects")).sort(
	(a,b) => a.data.order - b.data.order,
);
const summaries = projects.map((p) => ({
	id: p.id,
	title: p.data.title,
	summary: p.data.summary,
	stack: p.data.stack,
	status: p.data.status
}));
---
<Base title="Home" description="Main page for website">
	<header>
		<h1>Jaden Mantie</h1>
		<div class="location">
			<p>Saskatoon, SK</p>
			<p>Open to relocate</p>
		</div>
	</header>
	<main class="grid">

		<div class="intro">
			<p>Software Developer</p>
			<p>[YOUR ONE-LINE INTRO]</p>
		</div>
		
		<div aria-hidden="true" class="orb">
			<span>JM</span>
		</div>

		<div class="hub">
			<Hub projects={summaries} client:load/>
		</div>
	</main>
	<footer>
		<div>
			<kbd>Enter</kbd>
			<span>Select</span>
		</div>
		<div>
			<kbd>Esc</kbd>
			<span>Back</span>
		</div>
	</footer>
</Base>